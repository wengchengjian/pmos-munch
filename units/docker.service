[Unit]
Description=Docker Application Container Engine
Documentation=https://docs.docker.com
After=network-online.target containerd.service
Wants=network-online.target
Requires=containerd.service

[Service]
Type=notify
ExecStartPre=/usr/sbin/modprobe overlay
ExecStartPre=/usr/sbin/modprobe br_netfilter
ExecStartPre=/usr/sbin/modprobe veth
ExecStartPre=/usr/sbin/modprobe bridge
ExecStartPre=/usr/sbin/modprobe ip_tables
ExecStartPre=/usr/sbin/modprobe iptable_nat
ExecStartPre=/usr/sbin/modprobe nf_nat
ExecStartPre=/usr/sbin/modprobe xt_MASQUERADE
ExecStartPre=/usr/sbin/modprobe xt_conntrack
ExecStartPre=-/usr/sbin/sysctl -w net.ipv4.ip_forward=1
ExecStartPre=-/usr/sbin/sysctl -w net.bridge.bridge-nf-call-iptables=1
ExecStart=/usr/sbin/dockerd
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=0
Restart=always
RestartSec=2
StartLimitBurst=3
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
